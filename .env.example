# Salin ke .env di VPS. Jangan commit file .env.
#
# Berkas ini khusus untuk VPS (auto-comment.tech) yang berdiri sendiri.
# Sandbox Vercel + Railway + Supabase diatur lewat dashboard masing-masing,
# bukan lewat berkas ini.

DEBUG=false
FRONTEND_URL=https://auto-comment.tech,https://www.auto-comment.tech
ACME_EMAIL=admin@auto-comment.tech

# Wajib: generate dengan
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

SECRET_KEY=ganti-dengan-string-acak
LOG_LEVEL=INFO
RATE_LIMIT_PER_IP_PER_DAY=10
PLAYWRIGHT_TIMEOUT_MS=10000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
CELERY_CONCURRENCY=1

# --- Database akun pengguna (milik VPS sendiri, bukan Supabase) -------------
# Dibuat otomatis oleh GitHub Actions saat deploy kalau belum ada. Isi manual
# hanya kalau ingin menentukan sendiri:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=godam
POSTGRES_DB=godam

# Boleh tidaknya orang membuat akun baru di website publik.
AUTH_ALLOW_REGISTER=true

# Akun pemilik (opsional). Tetap bisa login walau database sedang bermasalah.
# Buat hash-nya dengan: cd backend && python buat_akun.py
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Diisi otomatis oleh GitHub Actions saat deploy. Untuk uji lokal biarkan kosong.
# BACKEND_IMAGE=ghcr.io/OWNER/instagram-automation-backend:latest
# FRONTEND_IMAGE=ghcr.io/OWNER/instagram-automation-frontend:latest
