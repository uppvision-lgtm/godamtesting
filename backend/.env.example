APP_NAME=Instagram Auto Comment Bot API
DEBUG=true
HOST=127.0.0.1
PORT=8000

FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# Dipakai generate komentar. Pilihan tone (positif/netral/negatif) dikirim dari form frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
MAX_POSTS_PER_JOB=10
COMMENT_STATE_DIR=.comment-state
# ===== Ringankan browser (lihat browser_config.py) =====
# 1 Chromium dipakai bersama semua bot (tiap bot = 1 tab). Hasil ukur 5 bot:
# 5 browser terpisah 1822MB/41 proses vs 1 browser + 5 tab 1138MB/13 proses.
# Set 0 untuk kembali ke 1 browser per bot (lebih terisolasi, jauh lebih berat).
LIVE_SHARED_BROWSER=1
# Batas browser (bot) yang boleh jalan bersamaan.
LIVE_MAX_SESSIONS=5
# Ukuran jendela: lebih kecil = screenshot lebih ringan.
LIVE_VIEWPORT_WIDTH=1000
LIVE_VIEWPORT_HEIGHT=700
# Frame Chrome Live: interval, kualitas JPEG, dan berhenti otomatis kalau tidak
# ada yang menonton selama LIVE_FRAME_IDLE_MS. Set interval 0 = matikan gambar.
LIVE_FRAME_INTERVAL_MS=900
LIVE_FRAME_QUALITY=55
LIVE_FRAME_IDLE_MS=3000
# Set 1 kalau ingin memblokir gambar juga (paling hemat, tapi tampilan Chrome
# Live jadi tanpa gambar). Font & media selalu diblokir.
LIVE_BLOCK_IMAGES=0
# Timpa flag Chromium kalau perlu (dipisah spasi).
# LIVE_BROWSER_ARGS=--no-sandbox --disable-dev-shm-usage
# ===== Angka realtime di landing page (lihat presence.py) =====
# Stream SSE ditutup rapi tiap sekian detik lalu browser menyambung ulang.
# 55 detik aman untuk batas fungsi Vercel (60 detik); di server sendiri boleh
# dibuat jauh lebih besar, mis. 600.
PRESENCE_STREAM_MAX_SECONDS=55
# Tenggang setelah koneksi putus sebelum pengunjung dianggap pergi. Membuat
# penyambungan ulang tidak terlihat berkedip. Kecilkan kalau ingin angka turun
# lebih cepat saat orang menutup tab.
PRESENCE_GRACE_SECONDS=5
# Umur satu ping pada jalur cadangan (kalau SSE diblokir jaringan).
PRESENCE_TTL_SECONDS=45
PLAYWRIGHT_TIMEOUT_MS=10000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
CELERY_CONCURRENCY=1
LOG_LEVEL=INFO
CREDENTIAL_ENCRYPTION_KEY=
RATE_LIMIT_PER_IP_PER_DAY=10
COMMENT_CACHE_TTL_SECONDS=3600

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
SECRET_KEY=change-me-in-development

# ===== Penyimpanan permanen (Supabase Storage) =====
# Disk container bersifat sementara: tanpa ini, template dan video hasil render
# hilang setiap kali deploy ulang. Kosongkan untuk memakai disk lokal saja.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
SUPABASE_PUBLIC_BUCKET=true
SUPABASE_FILE_LIMIT_MB=512

# ===== Auto edit video =====
MEDIA_DIR=.media
VIDEO_PRESET=veryfast
VIDEO_CRF=23
VIDEO_MAX_ACTIVE_JOBS=2
VIDEO_MAX_SOURCE_SECONDS=300
VIDEO_JOB_RETENTION_HOURS=24

# ===== Auto upload Instagram =====
UPLOAD_MAX_VIDEO_MB=300
UPLOAD_WAIT_SECONDS=180
