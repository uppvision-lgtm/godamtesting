# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
BASE_URL=http://localhost:4000

# Identitas yang tampil di halaman legal.
APP_NAME=Auto Upload Sosmed
APP_OWNER=
APP_CONTACT_EMAIL=

# Rahasia untuk menandatangani cookie sesi aplikasi ini. Buat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ── Mode sesi ────────────────────────────────────────────────────────────────
# Tidak ada CLIENT_ID / CLIENT_SECRET sama sekali di sini.
#
# Aplikasi ini bekerja dengan cookie sesi milik masing-masing pengguna, yang
# mereka tempelkan sendiri lewat tombol "Hubungkan" di dalam aplikasi. Jadi:
#   • tidak perlu mendaftarkan app di dashboard platform mana pun,
#   • tidak perlu redirect URI,
#   • tidak ada proses review,
#   • tidak perlu cloudflared/ngrok, karena semua platform menerima file
#     langsung (Instagram & Threads tidak lagi menarik video dari URL).

# ── Facebook & Threads: doc_id GraphQL internal ──────────────────────────────
# Keduanya tidak punya endpoint posting publik yang bisa dipakai dengan cookie,
# jadi web mereka memakai GraphQL internal dengan `doc_id`. Nilainya berubah
# setiap kali Facebook/Threads memperbarui tampilannya.
#
# Cara mengambilnya (30 detik), langkah lengkap ada di README §doc_id:
#   DevTools → Network → filter "graphql" → posting satu video manual →
#   salin doc_id dari URL request yang muncul.
#
# Selama kosong, hanya Facebook & Threads yang belum bisa upload. Empat
# platform lain (Instagram, TikTok, X, YouTube) sudah bisa dipakai.
FB_DOC_ID_VIDEO_UPLOAD=
THREADS_DOC_ID_CREATE_POST=

# Opsional — hanya kalau kamu juga punya app Meta sendiri dan ingin menerima
# webhook "hapus data" dari Meta di /api/data-deletion/meta.
META_APP_SECRET=

# ── Opsi opsional lainnya ────────────────────────────────────────────────────
# User-Agent yang dipakai saat bicara ke platform. Biarkan kosong = Chrome terkini.
# USER_AGENT=

# Privacy default TikTok (0 = publik, 1 = teman, 2 = hanya saya).
# Bisa juga diubah per-upload dari dropdown "Opsi lanjutan" di UI.
TIKTOK_WEB_PRIVACY=0
